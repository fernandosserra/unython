# .gitignore - Protocolo de Camuflagem Genial

# 1. ARTEFATOS DE AMBIENTE VIRTUAL (VENV) E NODE
/venv/
.venv/
/env/
node_modules/
**/node_modules/

# 2. ARTEFATOS DE SEGURANÇA
config/credentials.json
config/token.json
config/secrets.toml
config/secrets.local.toml

# 3. ARTEFATOS DE DADOS E CACHE
/data/*.db
/data/*.sqlite
__pycache__/
**/__pycache__/
.pytest_cache/
.vscode/
.idea/

# 4. Logs e Executáveis
*.log
*.exe
*.pyc
